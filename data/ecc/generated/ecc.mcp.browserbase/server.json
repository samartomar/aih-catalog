{
  "description": "Cloud browser sessions via Browserbase",
  "name": "browserbase",
  "packages": [
    {
      "environmentVariables": [
        {
          "description": "BROWSERBASE_API_KEY",
          "isRequired": true,
          "isSecret": true,
          "name": "BROWSERBASE_API_KEY"
        }
      ],
      "identifier": "@browserbasehq/mcp-server-browserbase",
      "registryType": "npm",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "version": "2.4.3"
    }
  ]
}
