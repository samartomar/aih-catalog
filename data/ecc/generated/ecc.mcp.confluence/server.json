{
  "description": "Confluence Cloud integration — search pages, retrieve content, explore spaces",
  "name": "confluence",
  "packages": [
    {
      "environmentVariables": [
        {
          "description": "CONFLUENCE_BASE_URL",
          "isRequired": true,
          "isSecret": true,
          "name": "CONFLUENCE_BASE_URL"
        },
        {
          "description": "CONFLUENCE_EMAIL",
          "isRequired": true,
          "isSecret": true,
          "name": "CONFLUENCE_EMAIL"
        },
        {
          "description": "CONFLUENCE_API_TOKEN",
          "isRequired": true,
          "isSecret": true,
          "name": "CONFLUENCE_API_TOKEN"
        }
      ],
      "identifier": "confluence-mcp-server",
      "registryType": "npm",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "version": "1.3.3"
    }
  ]
}
