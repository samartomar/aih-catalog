{
  "name": "@aihq/catalog",
  "version": "0.2.0",
  "description": "AIH Catalog qualification producer for AI Development Assurance.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samartomar/aih-catalog.git"
  },
  "homepage": "https://github.com/samartomar/aih-catalog#readme",
  "bugs": {
    "url": "https://github.com/samartomar/aih-catalog/issues"
  },
  "keywords": [
    "ai-harness",
    "aih",
    "catalog",
    "dsse",
    "ed25519",
    "evidence"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog-index.json": "./defaults/catalog-index-v1.json",
    "./catalog-collections.json": "./defaults/catalog-collections-v1.json",
    "./catalog-presentation.json": "./defaults/catalog-presentation-v1.json",
    "./catalog-qualification.json": "./defaults/catalog-qualification-v1.json",
    "./signed-catalog.json": "./defaults/signed-catalog-v2.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/generate-catalog-index.mjs && node tools/generate-catalog-collections.mjs && node tools/clean-dist.mjs && tsc -p tsconfig.build.json && node tools/ensure-cli-executable.mjs",
    "generate:default-candidate": "node dist/cli.js generate-candidate",
    "lint": "biome check .",
    "repo:doctor": "node tools/repo-ai-tools.mjs doctor-codex",
    "repo:init": "node tools/repo-ai-tools.mjs setup-codex",
    "test": "vitest run",
    "sign:candidate": "node dist/cli.js sign-candidate",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:core-v2-lock": "node tools/verify-core-v2-lock.mjs",
    "verify:workflow-action-pins": "node tools/verify-pinned-actions.mjs",
    "verify:cold-external-admin": "node tools/verify-cold-external-admin.mjs",
    "verify:default-evidence-chain": "vitest run tests/supported/default-evidence-chain.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test",
    "generate:catalog-index": "node tools/generate-catalog-index.mjs",
    "check:catalog-index": "node tools/generate-catalog-index.mjs --check && node tools/generate-catalog-collections.mjs --check && node tools/generate-catalog-qualification.mjs --check && node tools/generate-catalog-presentation.mjs --check",
    "generate:catalog-collections": "node tools/generate-catalog-collections.mjs",
    "generate:catalog-qualification": "node tools/generate-catalog-qualification.mjs",
    "prepare:core-collection": "node tools/prepare-core-collection.mjs",
    "stage:source-closure": "node tools/stage-source-closure.mjs",
    "generate:catalog-presentation": "node tools/generate-catalog-presentation.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {},
  "bin": {
    "aih-supported": "dist/cli.js"
  },
  "files": [
    "dist",
    "defaults",
    "README.md"
  ]
}
