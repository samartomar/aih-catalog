    "test": "vitest run --config vitest.transition.config.ts",
    "sign:candidate": "node dist/cli.js sign-candidate",
    "test:cov": "vitest run --config vitest.transition.config.ts --coverage",
    "typecheck": "tsc --noEmit",
    "verify:workflow-action-pins": "node tools/verify-pinned-actions.mjs",
    "produce:ecc": "npm run build:dist && node tools/produce-upstream-inputs.mjs ecc",
    "produce:superpowers": "npm run build:dist && node tools/produce-upstream-inputs.mjs superpowers",
    "produce:mattpocock": "npm run build:dist && node tools/produce-upstream-inputs.mjs mattpocock",
    "verify": "npm run build:dist && npm run typecheck && npm run lint && npm run check:materials && npm test && npm run verify:workflow-action-pins && npm run check:baseline-schemas && npm run check:contract-fixtures && npm run check:spdx-data && npm run check:restructuring",
    "generate:catalog-index": "node tools/generate-catalog-index.mjs",
    "generate:catalog-collections": "node tools/generate-catalog-collections.mjs",
    "generate:catalog-qualification": "node tools/generate-catalog-qualification.mjs",
