{
  "name": "@aihq/catalog",
  "version": "0.3.0",
  "description": "AIH Catalog qualification producer for AI Development Assurance.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samartomar/aih-catalog.git"
  },
  "homepage": "https://github.com/samartomar/aih-catalog#readme",
  "bugs": {
    "url": "https://github.com/samartomar/aih-catalog/issues"
  },
  "keywords": [
    "ai-harness",
    "aih",
    "catalog",
    "dsse",
    "ed25519",
    "evidence"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog-index.json": "./defaults/catalog-index-v1.json",
    "./catalog-collections.json": "./defaults/catalog-collections-v1.json",
    "./catalog-presentation.json": "./defaults/catalog-presentation-v1.json",
    "./catalog-qualification.json": "./defaults/catalog-qualification-v1.json",
    "./signed-catalog.json": "./defaults/signed-catalog-v2.json",
    "./catalog-categories.json": "./defaults/catalog-categories-v1.json",
    "./catalog-runtime-descriptors.json": "./defaults/catalog-runtime-descriptors-v1.json",
    "./catalog-authoring-bundle.json": "./defaults/catalog-authoring-bundle-v1.json",
    "./catalog-core-qualification.json": "./defaults/catalog-core-qualification-v1.json",
    "./catalog-scanner-evidence.json": "./defaults/catalog-scanner-evidence-v1.json",
    "./catalog-scanner-providers.json": "./defaults/catalog-scanner-providers-v1.json",
    "./catalog-public-baseline.json": "./defaults/catalog-public-baseline-v1.json",
    "./catalog-framework-ecc.json": "./defaults/catalog-framework-ecc-v1.json",
    "./catalog-framework-superpowers.json": "./defaults/catalog-framework-superpowers-v1.json",
    "./catalog-framework-plugins.json": "./defaults/catalog-framework-plugins-v1.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/check-not-candidate.mjs && node tools/generate-catalog-index.mjs && node tools/generate-catalog-collections.mjs && node tools/check-not-candidate.mjs && node tools/clean-dist.mjs && tsc -p tsconfig.build.json && node dist/production/catalog-defaults-v1.js && node tools/ensure-cli-executable.mjs",
    "build:dist": "node tools/check-not-candidate.mjs && node tools/clean-dist.mjs && tsc -p tsconfig.build.json && node dist/production/catalog-defaults-v1.js && node tools/ensure-cli-executable.mjs",
    "build:candidate": "node tools/build-candidate.mjs",
    "generate:default-candidate": "node dist/cli.js generate-candidate",
    "lint": "biome check .",
    "repo:doctor": "node tools/repo-ai-tools.mjs doctor-codex",
    "repo:init": "node tools/repo-ai-tools.mjs setup-codex",
    "test": "vitest run",
    "sign:candidate": "node dist/cli.js sign-candidate",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:core-v2-lock": "node tools/verify-core-v2-lock.mjs",
    "verify:workflow-action-pins": "node tools/verify-pinned-actions.mjs",
    "verify:cold-external-admin": "node tools/verify-cold-external-admin.mjs",
    "verify:default-evidence-chain": "vitest run tests/supported/default-evidence-chain.test.ts",
    "produce:ecc": "npm run build:dist && node tools/produce-upstream-inputs.mjs ecc",
    "produce:superpowers": "npm run build:dist && node tools/produce-upstream-inputs.mjs superpowers",
    "produce:mattpocock": "npm run build:dist && node tools/produce-upstream-inputs.mjs mattpocock",
    "produce:ponytail": "npm run build:dist && node tools/produce-upstream-inputs.mjs ponytail",
    "verify": "npm run typecheck && npm run lint && npm run build:dist && npm run check:catalog-index && npm run build && npm test",
    "generate:catalog-index": "node tools/generate-catalog-index.mjs",
    "check:catalog-index": "node tools/check-not-candidate.mjs && node tools/generate-catalog-index.mjs --check && node tools/generate-catalog-collections.mjs --check && node tools/generate-catalog-qualification.mjs --check && node tools/generate-catalog-presentation.mjs --check && node tools/generate-catalog-categories.mjs --check && node tools/generate-catalog-runtime-descriptors.mjs --check && node dist/production/catalog-defaults-v1.js --check && node tools/check-committed-catalog-defaults.mjs",
    "generate:catalog-collections": "node tools/generate-catalog-collections.mjs",
    "generate:catalog-qualification": "node tools/generate-catalog-qualification.mjs",
    "prepare:core-collection": "node tools/prepare-core-collection.mjs",
    "stage:source-closure": "node tools/stage-source-closure.mjs",
    "generate:catalog-presentation": "node tools/generate-catalog-presentation.mjs",
    "generate:catalog-categories": "node tools/generate-catalog-categories.mjs",
    "generate:catalog-runtime-descriptors": "node tools/generate-catalog-runtime-descriptors.mjs",
    "prepublishOnly": "node tools/check-not-candidate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {},
  "bin": {
    "aih-supported": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/production/**",
    "dist/production/source-data-v1.*",
    "defaults",
    "README.md"
  ]
}
