    "prepack": "npm run build:dist",
    "prepublishOnly": "node tools/refuse-publication.mjs",
    "test:historical": "vitest run --config vitest.config.ts",
    "generate:release": "npm run build:dist && node tools/generate-release.mjs",
    "check:release": "node tools/check-release.mjs",
    "prepare:candidate": "npm run build:dist && node tools/prepare-candidate.mjs",
    "measure:candidate": "node tools/measure-candidate.mjs",
    "check:materials": "node tools/check-not-candidate.mjs && node tools/generate-release.mjs --check && node tools/generate-extensions-release.mjs --check && node tools/generate-ecc-release.mjs --check && node tools/generate-superpowers-release.mjs --check && node tools/generate-anthropic-release.mjs --check && node tools/generate-project-basics-release.mjs --check && node tools/generate-extensions-17-release.mjs --check && node tools/check-release.mjs && node tools/generate-catalog-index.mjs --check && node tools/generate-catalog-collections.mjs --check && node tools/generate-catalog-presentation.mjs --check && node tools/generate-catalog-categories.mjs --check && node tools/generate-catalog-runtime-descriptors.mjs --check && node tools/build-nuclei-helper.mjs --check",
    "historical:verify:core-v2-lock": "node tools/verify-core-v2-lock.mjs",
    "historical:verify:cold-external-admin": "node tools/verify-cold-external-admin.mjs",
    "historical:verify:default-evidence-chain": "vitest run tests/supported/default-evidence-chain.test.ts",
    "historical:check:catalog-index": "node tools/check-not-candidate.mjs && node tools/generate-catalog-index.mjs --check && node tools/generate-catalog-collections.mjs --check && node tools/generate-catalog-qualification.mjs --check && node tools/generate-catalog-presentation.mjs --check && node tools/generate-catalog-categories.mjs --check && node tools/generate-catalog-runtime-descriptors.mjs --check && node dist/production/catalog-defaults-v1.js --check && node tools/check-committed-catalog-defaults.mjs",
    "build:nuclei": "node tools/build-nuclei-helper.mjs",
    "check:baseline-schemas": "node tools/generate-baseline-schemas.mjs --check",
    "prepare:release": "npm run build:dist && node tools/prepare-release.mjs",
    "generate:contract-fixtures": "node tools/generate-contract-fixtures.mjs",
    "check:contract-fixtures": "node tools/generate-contract-fixtures.mjs --check",
    "check:scan-fixtures": "node tools/check-pinned-scan-fixtures.mjs",
    "check:spdx-data": "node tools/generate-spdx-data.mjs --check",
    "check:restructuring": "node tools/derive-restructuring-expectation.mjs --check && node tools/check-restructuring.mjs"
