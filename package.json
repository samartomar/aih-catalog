{
  "name": "@aihq/catalog",
  "version": "0.1.0",
  "description": "Canonical Catalog content, pinned material and generic executable recipes; publication blocked during migration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samartomar/aih-catalog.git"
  },
  "homepage": "https://github.com/samartomar/aih-catalog#readme",
  "bugs": {
    "url": "https://github.com/samartomar/aih-catalog/issues"
  },
  "keywords": [
    "ai-harness",
    "aih",
    "catalog",
    "dsse",
    "ed25519",
    "evidence"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/release/contracts.d.ts",
      "import": "./dist/release/contracts.js"
    },
    "./reader": {
      "types": "./dist/release/reader.d.ts",
      "import": "./dist/release/reader.js"
    },
    "./node": {
      "types": "./dist/release/node.d.ts",
      "import": "./dist/release/node.js"
    },
    "./release.json": "./release/release.json",
    "./release-1.1.json": "./release/release-1.1.json",
    "./release-native-fixture.json": "./release/release-native-fixture.json",
    "./release-native-bundles.json": "./release/release-native-bundles.json",
    "./schemas/release/1.0.0.json": "./schemas/release/1.0.0.json",
    "./schemas/release/1.1.0.json": "./schemas/release/1.1.0.json",
    "./schemas/release/1.2.0.json": "./schemas/release/1.2.0.json",
    "./package.json": "./package.json",
    "./workflows/nuclei": "./workflows/nuclei/author.mjs",
    "./workflows/nuclei/manifest.json": "./workflows/nuclei/manifest.json",
    "./release-guide.json": "./release/release-guide.json",
    "./producer": {
      "types": "./dist/release/producer.d.ts",
      "import": "./dist/release/producer.js"
    },
    "./schemas/producer-declaration/3.0.0.json": "./schemas/producer-declaration/3.0.0.json",
    "./release-extensions.json": "./release/release-extensions.json",
    "./release-ecc.json": "./release/release-ecc.json",
    "./release-superpowers.json": "./release/release-superpowers.json",
    "./release-anthropic.json": "./release/release-anthropic.json"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "npm run build:dist",
    "build:dist": "node tools/check-not-candidate.mjs && node tools/clean-dist.mjs && tsc -p tsconfig.build.json && node tools/ensure-cli-executable.mjs",
    "build:candidate": "node tools/build-candidate.mjs",
    "generate:default-candidate": "node dist/cli.js generate-candidate",
    "lint": "biome check .",
    "repo:doctor": "node tools/repo-ai-tools.mjs doctor-codex",
    "repo:init": "node tools/repo-ai-tools.mjs setup-codex",
    "test": "vitest run --config vitest.transition.config.ts",
    "sign:candidate": "node dist/cli.js sign-candidate",
    "test:cov": "vitest run --config vitest.transition.config.ts --coverage",
    "typecheck": "tsc --noEmit",
    "verify:workflow-action-pins": "node tools/verify-pinned-actions.mjs",
    "produce:ecc": "npm run build:dist && node tools/produce-upstream-inputs.mjs ecc",
    "produce:superpowers": "npm run build:dist && node tools/produce-upstream-inputs.mjs superpowers",
    "produce:mattpocock": "npm run build:dist && node tools/produce-upstream-inputs.mjs mattpocock",
    "verify": "npm run typecheck && npm run lint && npm run build:dist && npm run check:materials && npm test && npm run verify:workflow-action-pins",
    "generate:catalog-index": "node tools/generate-catalog-index.mjs",
    "generate:catalog-collections": "node tools/generate-catalog-collections.mjs",
    "generate:catalog-qualification": "node tools/generate-catalog-qualification.mjs",
    "prepare:core-collection": "node tools/prepare-core-collection.mjs",
    "stage:source-closure": "node tools/stage-source-closure.mjs",
    "generate:catalog-presentation": "node tools/generate-catalog-presentation.mjs",
    "generate:catalog-categories": "node tools/generate-catalog-categories.mjs",
    "generate:catalog-runtime-descriptors": "node tools/generate-catalog-runtime-descriptors.mjs",
    "prepublishOnly": "node tools/refuse-publication.mjs",
    "test:historical": "vitest run --config vitest.config.ts",
    "generate:release": "npm run build:dist && node tools/generate-release.mjs",
    "check:release": "node tools/check-release.mjs",
    "prepare:candidate": "npm run build:dist && node tools/prepare-candidate.mjs",
    "measure:candidate": "node tools/measure-candidate.mjs",
    "check:materials": "node tools/check-not-candidate.mjs && node tools/generate-release.mjs --check && node tools/generate-extensions-release.mjs --check && node tools/generate-ecc-release.mjs --check && node tools/generate-superpowers-release.mjs --check && node tools/generate-anthropic-release.mjs --check && node tools/check-release.mjs && node tools/generate-catalog-index.mjs --check && node tools/generate-catalog-collections.mjs --check && node tools/generate-catalog-presentation.mjs --check && node tools/generate-catalog-categories.mjs --check && node tools/generate-catalog-runtime-descriptors.mjs --check && node tools/build-nuclei-helper.mjs --check",
    "historical:verify:core-v2-lock": "node tools/verify-core-v2-lock.mjs",
    "historical:verify:cold-external-admin": "node tools/verify-cold-external-admin.mjs",
    "historical:verify:default-evidence-chain": "vitest run tests/supported/default-evidence-chain.test.ts",
    "historical:check:catalog-index": "node tools/check-not-candidate.mjs && node tools/generate-catalog-index.mjs --check && node tools/generate-catalog-collections.mjs --check && node tools/generate-catalog-qualification.mjs --check && node tools/generate-catalog-presentation.mjs --check && node tools/generate-catalog-categories.mjs --check && node tools/generate-catalog-runtime-descriptors.mjs --check && node dist/production/catalog-defaults-v1.js --check && node tools/check-committed-catalog-defaults.mjs",
    "build:nuclei": "node tools/build-nuclei-helper.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1"
  },
  "files": [
    "dist/release",
    "release",
    "schemas/release",
    "schemas/core-recipe",
    "README.md",
    "CHANGELOG.md",
    "docs/FRAMEWORK-TEMPLATES.md",
    "producer/templates/framework",
    "workflows/nuclei/bin",
    "workflows/nuclei/author.mjs",
    "workflows/nuclei/manifest.json",
    "workflows/nuclei/AUTHORING.md",
    "workflows/nuclei/THIRD-PARTY-NOTICES.md",
    "schemas/producer-declaration",
    "docs/PUBLIC-AUTHORING.md",
    "producer/templates/public",
    "dist/producer/declaration.js",
    "dist/producer/declaration.d.ts",
    "dist/producer/authored.d.ts",
    "dist/producer/errors.js",
    "dist/producer/generate.js",
    "dist/producer/json.js",
    "dist/producer/template.js",
    "dist/producer/tree.js",
    "dist/producer/plugin.js",
    "producer/extensions",
    "docs/EXTENSIONS-CONTENT.md",
    "docs/EXTENSIONS-INVENTORY.md",
    "producer/ecc",
    "docs/ECC-CONTENT.md",
    "docs/ECC-INVENTORY.md",
    "producer/superpowers",
    "docs/SUPERPOWERS-CONTENT.md",
    "docs/SUPERPOWERS-INVENTORY.md",
    "producer/anthropic",
    "docs/ANTHROPIC-CONTENT.md",
    "docs/ANTHROPIC-INVENTORY.md"
  ],
  "private": true
}
