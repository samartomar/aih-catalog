{
  "name": "@aihq/catalog",
  "version": "0.1.0",
  "description": "Read AI content sources, identify their items, check them and plan deterministic installations for nine AI clients.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samartomar/aih-catalog.git"
  },
  "homepage": "https://github.com/samartomar/aih-catalog#readme",
  "bugs": {
    "url": "https://github.com/samartomar/aih-catalog/issues"
  },
  "keywords": [
    "ai-harness",
    "aih",
    "catalog",
    "agent-skills",
    "mcp",
    "install-plan"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./source": {
      "types": "./dist/catalog/source.d.ts",
      "import": "./dist/catalog/source.js"
    },
    "./node": {
      "types": "./dist/catalog/node.d.ts",
      "import": "./dist/catalog/node.js"
    },
    "./producer": {
      "types": "./dist/catalog/producer.d.ts",
      "import": "./dist/catalog/producer.js"
    },
    "./reader": {
      "types": "./dist/catalog/reader.d.ts",
      "import": "./dist/catalog/reader.js"
    },
    "./contracts": {
      "types": "./dist/catalog/contracts.d.ts",
      "import": "./dist/catalog/contracts.js"
    }
  },
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "build": "npm run build:dist",
    "build:dist": "node tools/clean-dist.mjs && tsc -p tsconfig.build.json",
    "generate:profiles": "node tools/generate-profiles.mjs",
    "check:profiles": "node tools/generate-profiles.mjs --check",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "verify:workflow-action-pins": "node tools/verify-pinned-actions.mjs",
    "verify": "npm run build:dist && npm run check:profiles && npm run typecheck && npm run lint && npm test && npm run verify:workflow-action-pins",
    "port:maintained": "npm run build:dist && node tools/port-maintained.mjs",
    "port:remaining": "npm run build:dist && node tools/port-remaining.mjs",
    "port:ai-setup": "npm run build:dist && node tools/port-ai-setup.mjs",
    "port:report": "npm run build:dist && node tools/port-report.mjs",
    "check:consumer": "node tools/check-consumer.mjs",
    "repo:doctor": "node tools/repo-ai-tools.mjs doctor-codex",
    "repo:init": "node tools/repo-ai-tools.mjs setup-codex",
    "prepack": "npm run build:dist",
    "prepublishOnly": "node tools/refuse-publication.mjs"
  },
  "dependencies": {
    "@aihq/scan": "0.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@aihq/scan": "file:vendor/aihq-scan-0.1.0.tgz",
    "@biomejs/biome": "2.5.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "files": [
    "dist/catalog",
    "CHANGELOG.md"
  ],
  "private": true
}
