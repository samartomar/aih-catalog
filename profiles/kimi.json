{
  "agentFile": {
    "fields": [
      "name",
      "description"
    ],
    "format": "md",
    "model": "drop",
    "tools": {}
  },
  "arguments": "substituted",
  "checkedWith": [
    {
      "app": "kimi",
      "date": "2026-11-02",
      "version": "2.4.1"
    }
  ],
  "hookEvents": {
    "pre-tool-use": "PreToolUse",
    "session-start": "SessionStart"
  },
  "id": "kimi",
  "inputReferences": {
    "file": "unknown",
    "mcp-argv": "unknown",
    "mcp-env": "unknown",
    "mcp-header": "unknown"
  },
  "links": {
    "skill": "documented"
  },
  "mcpFile": {
    "remote": {
      "streamable-http": {
        "headers": "headers",
        "url": "url"
      }
    },
    "stdio": {
      "args": "args",
      "command": "command",
      "env": "env"
    }
  },
  "name": "Kimi Code",
  "places": {
    "agent": {
      "project": ".agents/agents/<name>.md"
    },
    "mcp": {
      "project": {
        "file": ".kimi-code/mcp.json",
        "format": "json",
        "key": "/mcpServers/<name>"
      }
    },
    "rule": {
      "project": {
        "always": {
          "file": "AGENTS.md",
          "merge": "markdown"
        }
      },
      "user": {
        "always": {
          "file": ".agents/AGENTS.md",
          "merge": "markdown"
        }
      }
    },
    "skill": {
      "project": ".agents/skills/<name>/",
      "user": ".kimi-code/skills/<name>/"
    }
  },
  "plugins": {
    "pin": "drops-on-update",
    "scopes": [
      "user"
    ],
    "verify": "none"
  },
  "ruleScopes": {
    "always": {
      "frontmatter": {}
    }
  },
  "schema": "urn:aihq:catalog:tool-profile:0.1.0",
  "userOnly": {
    "frontmatter": {
      "disableModelInvocation": true
    }
  },
  "version": 2
}
