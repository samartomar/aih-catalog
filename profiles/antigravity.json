    {
      "app": "antigravity-app",
      "date": "2026-11-02",
      "version": "2.28.2"
    }
  ],
  "configFiles": {
    "project": [
      ".agents/hooks.json",
      ".agents/plugins/"
    ],
    "user": [
      ".gemini/antigravity-cli/keybindings.json",
      ".gemini/antigravity-cli/settings.json",
      ".gemini/config/hooks.json",
      ".gemini/config/mcp_config.json",
      ".gemini/config/plugins/"
    ]
  },
  "disableBuiltIn": "not-documented",
  "hookEvents": {
    "post-tool-use": "PostToolUse",
    "pre-tool-use": "PreToolUse",
    "session-start": "SessionStart",
    "stop": "Stop"
  },
  "id": "antigravity",
  "inputReferences": {
    "file": "unknown",
    "mcp-argv": "unknown",
    "mcp-env": "unknown",
    "mcp-header": "unknown"
  },
  "links": {
    "skill": "not-documented"
  },
  "localPlugins": {
    "project": {
      "folder": ".agents/plugins/<plugin>/",
      "manifests": [
        ".antigravity-plugin/plugin.json",
        "plugin.json"
      ]
    },
    "user": {
      "folder": ".gemini/config/plugins/<plugin>/",
      "manifests": [
        ".antigravity-plugin/plugin.json",
        "plugin.json"
      ]
    }
  },
  "mcpFile": {
    "remote": {
      "streamable-http": {
        "headers": "headers",
        "url": "serverUrl"
      }
    },
    "stdio": {
      "args": "args",
      "command": "command",
      "env": "env"
    }
  },
  "name": "Antigravity",
  "places": {
    "agent": {
      "project": ".agents/agents/<name>.md"
    },
    "mcp": {
      "project": {
        "file": ".agents/mcp_config.json",
        "format": "json",
        "key": "/mcpServers/<name>"
      }
    },
    "rule": {
      "project": {
        "always": ".agents/rules/<name>.md",
        "by-description": ".agents/rules/<name>.md",
        "on-request": ".agents/rules/<name>.md",
        "paths": ".agents/rules/<name>.md"
      }
    },
    "skill": {
      "project": ".agents/skills/<name>/",
      "user": ".gemini/config/skills/<name>/"
    }
  },
  "plugins": {
    "pin": "none",
    "verify": "none"
  },
  "provides": {
    "agent": [
      "browser",
      "default",
      "research",
      "self"
    ],
    "command": [
      "add-dir",
