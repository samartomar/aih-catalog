      "antigravity-guide",
      "automation",
      "migrate-workflows",
      "run-workflow"
    ]
  },
  "ruleScopes": {
    "always": {
      "frontmatter": {
        "trigger": "always_on"
      }
    },
    "by-description": {
      "describe": [
        "description"
      ],
      "frontmatter": {
        "trigger": "model_decision"
      }
    },
    "on-request": {
      "frontmatter": {
        "trigger": "manual"
      }
    },
    "paths": {
      "form": "single-or-list",
      "frontmatter": {
        "trigger": "glob"
      },
      "globs": "globs"
    }
  },
  "schema": "urn:aihq:catalog:tool-profile:0.1.0",
  "userOnly": {
    "frontmatter": {
      "disable-model-invocation": true
    }
  },
  "version": 6
