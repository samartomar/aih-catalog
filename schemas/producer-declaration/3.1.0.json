                "$ref": "urn:aihq:catalog:release:1.2.0#/$defs/id"
              },
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "licensePath": {
                "$ref": "urn:aihq:catalog:release:1.2.0#/$defs/path"
              },
              "license": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
              },
              "pluginManifestPath": {
                "$ref": "urn:aihq:catalog:release:1.2.0#/$defs/path"
